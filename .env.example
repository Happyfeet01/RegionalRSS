COMPOSE_PROJECT_NAME=regionalrss

FEED_HOST=feeds.dasnetzundich.de
REGIONALRSS_PUBLIC_BASE_URL=https://feeds.dasnetzundich.de
REGIONALRSS_SITE_TITLE=RegionalRSS
REGIONALRSS_USER_AGENT=RegionalRSS/0.3 (+https://feeds.dasnetzundich.de/)

# Administrationsoberfläche unter /admin. Passwort-Hash und Sitzungsschlüssel
# mit den Befehlen aus der README erzeugen.
REGIONALRSS_ADMIN_USER=
REGIONALRSS_ADMIN_PASSWORD_HASH=
REGIONALRSS_SESSION_SECRET=

# Öffentliche Nutzerkonten. Für eine private Instanz auf "false" setzen.
REGIONALRSS_ALLOW_REGISTRATION=true
REGIONALRSS_MAX_SOURCES_PER_USER=20

# Absender und SMTP für die Bestätigung neuer Konten.
# MAIL_FROM ist ein vorhandenes Postfach/ein beim Mailanbieter erlaubter Absender.
REGIONALRSS_MAIL_FROM=
REGIONALRSS_MAIL_FROM_NAME=RegionalRSS
REGIONALRSS_SMTP_HOST=
REGIONALRSS_SMTP_PORT=587
# starttls (meist 587) oder ssl (meist 465); keine unverschlüsselte Anmeldung.
REGIONALRSS_SMTP_SECURITY=starttls
REGIONALRSS_SMTP_USER=
# Passwort in einfachen Anführungszeichen eintragen, damit $ wörtlich bleibt.
REGIONALRSS_SMTP_PASSWORD=

# Angaben für /datenschutz. Vor einer öffentlichen Freigabe vollständig ausfüllen.
REGIONALRSS_PRIVACY_CONTROLLER_NAME=
REGIONALRSS_PRIVACY_CONTROLLER_ADDRESS=
REGIONALRSS_PRIVACY_EMAIL=
REGIONALRSS_PRIVACY_HOSTING_PROVIDER=
REGIONALRSS_PRIVACY_MAIL_PROVIDER=
# Beispiel: "30 Tage; danach werden alte Borg-Backups gelöscht"
REGIONALRSS_PRIVACY_BACKUP_RETENTION=

# Namen gegebenenfalls an deine vorhandene Traefik-Installation anpassen.
TRAEFIK_NETWORK=proxy
TRAEFIK_CERTRESOLVER=letsencrypt

REGIONALRSS_TIMEOUT_SECONDS=12
REGIONALRSS_MAX_RESPONSE_BYTES=5242880
LOG_LEVEL=INFO
